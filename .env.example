FLASK_APP=run.py
FLASK_ENV=development
# FLASK_ENV controls which config class loads (config/config.py):
#   development (default) - debug on, SQLite allowed
#   production            - fails fast unless real secrets + PostgreSQL DATABASE_URL are set
#   testing               - used automatically by the Pytest suite
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
# Postgres example: postgresql://username:password@localhost:5432/ai_ops_db
# For quick local testing without Postgres installed, sqlite works too:
DATABASE_URL=sqlite:///ai_ops.db
